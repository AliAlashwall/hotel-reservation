<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only a launch theme. Everything after the first frame is Compose, so this needs
         to do nothing but avoid a white flash before the theme takes over. -->
    <style name="Theme.HotelReservation" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
